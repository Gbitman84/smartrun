rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SmartRun (production): each signed-in user can read/write only their own data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // SmartRoute (lab): separate data area, same rule.
    match /labUsers/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // quota/* is written only by the Cloud Function (admin SDK); no client access.
  }
}
